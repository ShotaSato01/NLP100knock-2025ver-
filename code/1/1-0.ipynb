   "source": [
    "p = \"パトカー\"\n",
    "t = \"タクシー\"\n",
    "\n",
    "p_len = len(p)\n",
    "t_len = len(t)\n",
    "output = []\n",
    "\n",
    "for i in range(min(p_len,t_len)):\n",
    "    output.append(p[i])\n",
    "    output.append(t[i])\n",
    "\n",
    "print(\"\".join(output))"
   ]
  }
